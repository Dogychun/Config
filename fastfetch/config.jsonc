{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "~/Pictures/Ascii/totoro.txt"
  },
  "display": {
    "separator": " - "
  },
  "modules": [
    {
      "type": "os",
      "key": "┌ 󰣇 ",
      "format": "Arch (btw)"
    },
    {
      "type": "wm",
      "key": "│ 󰨇 "
    },
    {
      "type": "terminal",
      "key": "│  "
    },
    {
      "type": "cpu",
      "key": "│  "
    },
    {
      "type": "gpu",
      "key": "│ 󰢮 "
    },
    {
      "type": "memory",
      "key": "│  "
    },
    {
      "type": "disk",
      "key": "│  "
    },
    {
      "type": "uptime",
      "key": "└ 󰪻 "
    }
  ]
}
